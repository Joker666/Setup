#!/usr/bin/env fish
# update-all -- upgrade everything on this machine
# Order: package managers first, then the tools they manage.
# Pass --dry to show what would be upgraded without changing anything.

argparse dry -- $argv; or exit 1

set -g _failures

function section
    set_color -o cyan
    echo
    echo "==> $argv"
    set_color normal
end

function run
    set_color brblack
    echo "\$ $argv"
    set_color normal
    command $argv
    or begin
        set_color red
        echo "!! failed: $argv"
        set_color normal
        set -a _failures "$argv"
    end
end

section Homebrew
# brew update only refreshes metadata; needed for accurate results either way
run brew update
if set -q _flag_dry
    run brew upgrade --dry-run
    run brew upgrade --cask --greedy --dry-run
else
    run brew upgrade
    run brew upgrade --cask --greedy
end

section "mise (runtimes: go, node, pnpm, python, ruby)"
if set -q _flag_dry
    run mise upgrade --dry-run
else
    run mise self-update -y
    run mise upgrade
end

section Rust
if set -q _flag_dry
    run rustup check
else
    run rustup update
end

section "uv tools"
if uv tool list 2>/dev/null | grep -q .
    if set -q _flag_dry
        echo "installed uv tools (no dry-run support; these would be upgraded):"
        run uv tool list
    else
        run uv tool upgrade --all
    end
else
    echo "no uv tools installed, skipping"
end

section "npm globals"
if type -q npm
    if set -q _flag_dry
        # npm outdated exits 1 when updates exist; that's information, not failure
        set_color brblack
        echo "\$ npm outdated -g"
        set_color normal
        command npm outdated -g
        or true
    else
        run npm update -g
    end
end

section "pnpm globals"
if type -q pnpm
    # pnpm v11 gives each global package its own workspace project, which
    # `pnpm update -g` and `pnpm outdated -g` silently fail to traverse, and
    # `add -g pkg@latest` can resolve the tag from stale cached metadata --
    # so ask the registry for the live version and install it explicitly.
    # @pnpm/exe is skipped: that's pnpm itself, file-linked from mise.
    for line in (pnpm ls -g --depth 0 --json 2>/dev/null | python -c "import json, sys; [print(name, dep['version']) for proj in json.load(sys.stdin) for name, dep in proj.get('dependencies', {}).items() if name != '@pnpm/exe']")
        set -l pkg (string split ' ' $line)
        set -l latest (pnpm view "$pkg[1]" version 2>/dev/null)
        if not set -q latest[1]
            echo "$pkg[1]: could not resolve latest version, skipping"
        else if test "$latest" = "$pkg[2]"
            echo "$pkg[1]: $pkg[2] (up to date)"
        else if set -q _flag_dry
            echo "$pkg[1]: $pkg[2] -> $latest"
        else
            run pnpm add -g "$pkg[1]@$latest"
        end
    end
end

section "go binaries"
if type -q go
    for bin in (go env GOPATH)/bin/*
        # each go binary embeds the package, module, and version it was built from
        set -l meta (go version -m $bin 2>/dev/null | awk '$1=="path"{p=$2} $1=="mod"{m=$2;v=$3} END{if (p) print p, m, v}' | string split ' ')
        set -q meta[3]; or continue
        if test "$meta[3]" = "(devel)"
            echo (basename $bin)": built from local source, skipping"
            continue
        end
        if set -q _flag_dry
            set -l latest (go list -m -f '{{.Version}}' "$meta[2]@latest" 2>/dev/null; or echo "?")
            if test "$latest" = "$meta[3]"
                echo (basename $bin)": $meta[3] (up to date)"
            else
                echo (basename $bin)": $meta[3] -> $latest"
            end
        else
            run go install "$meta[1]@latest"
        end
    end
end

section "pip globals"
if type -q pip
    if set -q _flag_dry
        run pip list --outdated
    else
        # one pip install with every name lets the resolver reconcile the
        # whole set, instead of upgrading each package in isolation
        set outdated (pip list --outdated --format=json | python -c "import json, sys; print('\n'.join(pkg['name'] for pkg in json.load(sys.stdin)))")
        if set -q outdated[1]
            run pip install -U $outdated
        else
            echo "all pip globals up to date"
        end
    end
end

# macOS system updates are intentionally not run here (they can require a
# restart). Check manually with:  softwareupdate --list

echo
if set -q _failures[1]
    set_color red
    echo "Completed with failures:"
    printf '  - %s\n' $_failures
    set_color normal
    exit 1
else
    set_color green
    if set -q _flag_dry
        echo "Dry run complete -- nothing was changed."
    else
        echo "Everything up to date."
    end
    set_color normal
end
