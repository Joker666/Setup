#!/bin/sh
# install -- symlink the maintenance scripts and fish files into place
# Symlinks keep the installed files in sync with this repo. A git pull is all
# an update needs. Safe to run again.
#
# config.fish is not linked because it holds machine-specific settings.
# Copy it by hand on a new machine.

set -e

repo=$(cd "$(dirname "$0")" && pwd)
bin="$HOME/.local/bin"
fish="$HOME/.config/fish"

# link SRC DEST: symlink SRC to DEST, and back up a real file at DEST that differs.
link() {
    if [ -f "$2" ] && [ ! -L "$2" ] && ! cmp -s "$1" "$2"; then
        mv "$2" "$2.bak"
        echo "backed up $2 to $2.bak"
    fi
    ln -sfn "$1" "$2"
    echo "linked $2 -> $1"
}

mkdir -p "$bin"
for src in "$repo"/scripts/*; do
    chmod +x "$src"
    link "$src" "$bin/$(basename "$src")"
done

# Link each fish file on its own, so local files in the same folders stay.
for dir in conf.d functions; do
    mkdir -p "$fish/$dir"
    for src in "$repo/fish/$dir"/*.fish; do
        [ -e "$src" ] || continue
        link "$src" "$fish/$dir/$(basename "$src")"
    done
done

case ":$PATH:" in
    *":$bin:"*) ;;
    *) echo "note: add $bin to PATH (fish: fish_add_path $bin)" ;;
esac
